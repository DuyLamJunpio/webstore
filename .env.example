# Sao chép tệp này thành `.env.local` rồi điền giá trị thật.
# `.env.local` không bao giờ được commit — nó chứa khoá bí mật của cổng thanh toán.

# ── PayOS ────────────────────────────────────────────────────────────
# Lấy tại https://my.payos.vn → Kênh thanh toán → Thông tin xác thực API.
# Thiếu một trong ba khoá này thì trang thanh toán sẽ chạy ở "chế độ xem thử"
# (dùng tài khoản ngân hàng cấu hình bên dưới, không có đối soát tự động).
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Chỉ dành cho đối tác tích hợp của PayOS — người bán thông thường bỏ trống.
# PAYOS_PARTNER_CODE=

# Đổi khi cần trỏ sang môi trường khác. Mặc định: https://api-merchant.payos.vn
# (cùng tên biến với SDK chính thức @payos/node)
# PAYOS_BASE_URL=

# ── Shopee Open Platform ─────────────────────────────────────────────
# Nguồn dữ liệu thật cho catalogue: sản phẩm, danh mục, tồn kho, lượt bán.
# Đăng ký ứng dụng tại https://open.shopee.com → App Management → tạo app,
# lấy Partner ID và Partner Key (Live Key khi bán thật, Test Key cho sandbox).
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# Mã cửa hàng — hiện ra sau khi uỷ quyền (`npm run shopee:auth`), điền lại vào đây.
SHOPEE_SHOP_ID=

# sandbox = môi trường thử của Shopee (partner_id và shop uỷ quyền đều riêng).
# Bỏ trống hoặc "live" để chạy thật.
# SHOPEE_ENV=sandbox

# Trang mà Shopee chuyển hướng tới sau khi chủ shop bấm đồng ý. Phải trùng với
# một trong các Redirect URL đã khai trong app. Chỉ cần đọc `?code=` trên thanh
# địa chỉ, không cần trang đó chạy thật.
# SHOPEE_REDIRECT_URL=https://open.shopee.com/

# Ngôn ngữ tên danh mục trả về. Mặc định: vi
# SHOPEE_LANGUAGE=vi

# ── Địa chỉ trang web ────────────────────────────────────────────────
# Dùng cho returnUrl / cancelUrl của PayOS và cho các URL og:image.
# Khi chạy máy cá nhân có thể bỏ trống — hệ thống sẽ tự suy ra từ request.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Webhook nhận thông báo "đã nhận tiền" — khai báo trong bảng điều khiển PayOS:
#   https://<tên-miền-của-bạn>/api/payos/webhook
# PayOS phải gọi được URL này từ internet. Khi chạy localhost, dùng ngrok/cloudflared,
# hoặc cứ để trang tự hỏi PayOS mỗi vài giây (đã có sẵn, chỉ chậm hơn vài giây).

# ── Tài khoản ngân hàng dự phòng (tuỳ chọn) ──────────────────────────
# Chỉ dùng khi chưa có khoá PayOS, để thử luồng thanh toán từ đầu đến cuối.
# SHOP_BANK_BIN: mã ngân hàng NAPAS 6 số — ví dụ 970422 (MB Bank), 970436 (Vietcombank).
# SHOP_BANK_BIN=970422
# SHOP_BANK_ACCOUNT=0123456789
# SHOP_BANK_ACCOUNT_NAME=NGUYEN VAN A
# SHOP_BANK_NAME=MB Bank

# ── Giá thử thanh toán ───────────────────────────────────────────────
# Ép mọi sản phẩm về mức giá này (đồng) và miễn phí giao hàng, để chuyển khoản
# thật mà không tốn tiền thật. XOÁ hoặc để trống trước khi bán hàng thật.
# NEXT_PUBLIC_TEST_PRICE=1000

# ── Email xác nhận đơn hàng (SMTP) ───────────────────────────────────
# Gửi thẳng từ hộp Gmail của shop — không cần tên miền riêng.
# SMTP_PASSWORD KHÔNG phải mật khẩu đăng nhập Gmail, mà là App Password 16 ký tự:
#   Tài khoản Google → Bảo mật → Xác minh 2 bước → Mật khẩu ứng dụng
# (phải bật Xác minh 2 bước thì mục Mật khẩu ứng dụng mới hiện ra)
# Thiếu hai biến này thì thanh toán vẫn chạy, chỉ là khách không nhận được thư.
SMTP_USER=
SMTP_PASSWORD=
# Tên hiển thị của người gửi. Bỏ trống thì mặc định là .
# SHOP_EMAIL_FROM=The Basic Concept <thebasicconcept.official@gmail.com>
# Gửi kèm một bản về hộp thư của shop để biết có đơn mới (tuỳ chọn).
# SHOP_EMAIL_BCC=
# Đổi khi dùng nhà cung cấp khác Gmail. Mặc định: smtp.gmail.com cổng 465.
# SMTP_HOST=
# SMTP_PORT=


# ── Trang quan tri (Laravel) ─────────────────────────────────────────
# Nguon du lieu that cua cua hang: san pham, gia, ton kho, don hang.
#   npm run sync:warehouse   -> keo catalogue ve lib/catalogue.generated.ts
# Don dat hang cung duoc day sang day de hien trong trang quan tri.
WAREHOUSE_API_URL=http://127.0.0.1:8000

# Phải trùng STOREFRONT_WEBHOOK_SECRET trong .env của Warehouse.WED
WAREHOUSE_WEBHOOK_SECRET=

# Kho anh (Supabase Storage) — noi trang quan tri luu anh san pham.
# Phai khop SUPABASE_PUBLIC_URL ben Warehouse.WED. De trong neu ben do van dung
# disk `local`, khi ay anh lay thang tu WAREHOUSE_API_URL nhu truoc.
WAREHOUSE_MEDIA_URL=
